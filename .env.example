# Supabase Postgres connection (set in Vercel dashboard for production)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# Direct Postgres connection string for the scoring engine (uses postgres pooler)
# Get from: Supabase Dashboard → Project Settings → Database → Connection pooling (Transaction mode)
DATABASE_URL="postgres://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres"
