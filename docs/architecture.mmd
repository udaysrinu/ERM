        UI[App.tsx · Screen state machine]
        UI --> Login[LoginScreen]
        UI --> Scope[ScopeScreen<br/>BU mosaic + archive]
        UI --> Quest[VectorCapturePipeline<br/>100 questions + uploads]
        UI --> Today[TodayScreen<br/>Live Brief + signature chip]
        UI --> Action[ActionPlanScreen]
        UI --> Evid[EvidenceScreen]
        UI --> Hist[HistoryScreen]
        UI --> Report[ReportScreen]
        UI --> Prov[ProvenanceScreen]
        UI --> Chat[NavigatorAssistant<br/>15-pattern matcher]
