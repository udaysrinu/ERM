    subgraph CDN["⚡ Vercel Edge"]
        Cache[("Edge Cache<br/>s-maxage=60 swr=300<br/>for /trend, /assessments")]
        Static[("Static assets<br/>1y immutable")]
    end

    subgraph VercelFn["☁️ Vercel Serverless Functions (api/)"]
        Auth["/api/auth/login"]
        AnalysisAPI["/api/assessments/[id]/analysis<br/>scoring + drift + roadmap + signatures"]
        TrendAPI["/api/assessments/trend<br/>per-pillar trajectories"]
        ListAPI["/api/assessments<br/>operator history"]
        CreateAPI["/api/responses/create<br/>finalize 100 vectors"]
        PdfAPI["/api/assessments/[id]/pdf<br/>5-page board PDF"]
        UploadURL["/api/evidence/upload-url<br/>signed PUT URL"]
        DownloadURL["/api/evidence/download-url<br/>signed GET URL · 5min TTL"]
    end

    subgraph SharedCode["📦 /shared (single source of truth)"]
        Static_TS[static.ts<br/>100 questions + 10 pillars + 4 dimensions<br/>+ benchmark profiles + provenance]
        Engines[engines.ts<br/>computeVectors · computeAnalytics<br/>computeDrift · generateRoadmap]
        Sigs[signatures.ts<br/>SHA-256 scoringInputHash + analysisHash<br/>+ catalog/spec versioning]
    end

    subgraph Supabase["🐘 Supabase (Postgres + Storage)"]
        Assess[(assessments<br/>id · entityId · operatorEmail<br/>status · overallScore)]
        Resp[(responses<br/>questionId · score · note<br/>evidenceName · evidencePath)]
        Bucket[("evidence bucket<br/>private · 10MB/file<br/>MIME allowlist<br/>key: assessmentId/qid-name")]
    end

